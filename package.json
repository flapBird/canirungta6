{
  "name": "vi-ready",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:data": "node scripts/validate-data.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/generate-og.mjs && node scripts/generate-seo.mjs",
    "build": "npm run validate:data && next build",
    "build:cloudflare": "npm run build",
    "start": "npx serve out -l 3000"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.6",
    "serve": "^14.2.8",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
